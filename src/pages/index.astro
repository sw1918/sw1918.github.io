---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PubList from '../components/PubList.astro';
import { site } from '../site.config';
import { getPubs, getPosts, fmtDate } from '../lib/content';

const selected = (await getPubs()).filter((p) => p.data.selected);
const posts = (await getPosts()).slice(0, 3);
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

// Structured data so search engines know who this page is about.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  affiliation: { '@type': 'Organization', name: site.affiliation },
  url: Astro.site?.href,
  sameAs: site.links.filter((l) => l.href.startsWith('http')).map((l) => l.href),
};
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />

  <section class="hero">
    <div>
      <h1>{site.name}</h1>
      <p class="lede">{site.title}, {site.affiliation}</p>
      <!-- Replace with your 2–3 sentence research statement. -->
      <p>
        I'm a human–computer interaction scholar studying how science is communicated, engaged with, and used on technology-mediated platforms like social media. 
        My work appears at venues including CHI and CSCW. I teach courses on design methods, research methods, input and
        interaction, social media, and tech ethics.
      </p>
      <p>
        I lead the <a href="https://pulse-lab-uw.github.io/">PULSE Lab</a> at the University of Washington.
      </p>
      <p>
        Outside teaching and research, I make games (like <a href="/projects/heronet">HeroNet</a> on Steam) and write <a href="/music">music</a>.
      </p>
      <ul class="inline-links">
        <li><a href={`mailto:${site.email}`}>Email</a></li>
        {site.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <img class="photo" src={site.photo} alt={`Photo of ${site.name}`} width="160" height="160" />
  </section>

  {news.length > 0 && (
    <section>
      <h2>News</h2>
      <ul class="news">
        {news.map((n) => (
          <li>
            <time datetime={n.data.date.toISOString()}>{fmtDate(n.data.date, { year: 'numeric', month: 'short' })}</time>
            <span set:html={n.data.text} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {selected.length > 0 && (
    <section>
      <h2>Selected publications</h2>
      <PubList pubs={selected} />
      <p class="small"><a href="/research">All publications →</a></p>
    </section>
  )}

  {posts.length > 0 && (
    <section>
      <h2>Recent writing</h2>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}`}>{p.data.title}</a>
            <div class="post-meta">{fmtDate(p.data.date)}</div>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
