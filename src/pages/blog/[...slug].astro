---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {post.data.tags.length > 0 && ' · '}
        <span class="tags">
          {post.data.tags.map((t) => <a class="tag" href={`/blog/tags/${t}`}>#{t}</a>)}
        </span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <hr />
  <p class="small"><a href="/blog">← All posts</a></p>
</Base>
