---
import Base from '../../../layouts/Base.astro';
import { getPosts, fmtDate } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <h1>#{tag}</h1>
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}`}>{p.data.title}</a>
        <div class="post-meta">{fmtDate(p.data.date)}</div>
      </li>
    ))}
  </ul>
  <p class="small"><a href="/blog">← All posts</a></p>
</Base>
